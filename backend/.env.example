# ---- Server ----
NODE_ENV=development
PORT=3000

# ---- Database (Aiven / any Postgres) ----
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require
# PG_MAX_POOL=10            # size the pool below your plan's max_connections

# ---- JWT ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Object storage (Cloudflare R2, S3-compatible) ----
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=filevault
# LOCAL_UPLOAD_DIR=./uploads   # optional filesystem fallback (non-prod)

# ---- Email (transactional, e.g. Gmail SMTP) ----
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM=FileVault <you@gmail.com>

# ---- App ----
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:3000

# ---- Distributed storage engine ----
REPLICATION_FACTOR=3
# HEARTBEAT_NODE_ID=1        # instance auto-heartbeat node id (prod)
# DEBUG_QUERIES=0            # set 1 to enable per-query logging (dev only)
# HEARTBEAT_MONITOR_DISABLED=0
# REPLICATOR_DISABLED=0